HOST=0.0.0.0
PORT=10000
# Online refresh and shared-history deletion are locked unless an administrator is logged in.
# ADMIN_SECRET_SHA256=<SHA-256 of a long random administrator secret>
# Optional free durable public data snapshots in this repository's GitHub Release:
# PUBLIC_DATA_REPOSITORY=cuteorca26/space-enthusiast-map
# GITHUB_DATA_TOKEN=<fine-grained token, this repository only, Contents read/write>
# For a server with persistent storage, set DATA_DIR to the mounted directory.
# DATA_DIR=/app/data
# Optional on Linux:
# FAA_NOTAM_BROWSER_EXECUTABLE=/usr/bin/chromium
# Keep Space-Track credentials in the hosting platform's secrets, never in Git.
